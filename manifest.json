{
  "manifest_version": 2,
  "name": "Mktero",
  "version": "0.2.6",
  "description": "Display opened Zotero PDFs as Markdown",
  "author": "Tony",
  "icons": {
    "48": "ui/icons/mktero.svg",
    "96": "ui/icons/mktero.svg"
  },
  "applications": {
    "zotero": {
      "id": "mktero@tenglvjun.github.io",
